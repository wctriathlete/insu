NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SEED_ADMIN_USER_ID=your_admin_user_uuid_here
STRIPE_SECRET_KEY=sk_test_your_key_here
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here
CRON_SECRET=a_random_secret_string
# Banxico SIE API token for the daily MXN FIX rate (free: banxico.org.mx/SieAPIRest/service/v1/token).
# Unset → MXN falls back to the FX_RATES constant; GTQ (Banguat) needs no key.
BANXICO_TOKEN=your_banxico_sie_token_here
OPENWEATHERMAP_API_KEY=your_owm_key_here
TOMORROW_IO_API_KEY=your_tio_key_here
GOOGLE_MAPS_API_KEY=your_google_maps_server_key_here
# Comma-separated IPs allowed to access /admin (leave empty to disable)
ADMIN_IP_ALLOWLIST=

# Sentry — create project at sentry.io and copy DSN here
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
